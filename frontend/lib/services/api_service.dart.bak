  /// Realiza una búsqueda global en el backend.
  Future<Map<String, dynamic>> search(String query, {String type = 'all'}) async {
    final params = <String, String>{'q': query, 'type': type};
    return await request('GET', '/search/?${_buildQuery(params)}', withAuth: false);
  }

