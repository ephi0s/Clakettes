  Future<Map<String, dynamic>> checkEventConflict(int festivalId, {required String venue, required DateTime start, DateTime? end, int? excludeEventId}) async {
    final params = <String, String>{'venue': venue, 'start_date': start.toIso8601String()};
    if (end != null) params['end_date'] = end.toIso8601String();
    if (excludeEventId != null) params['exclude_event_id'] = '$excludeEventId';
    return Map<String, dynamic>.from(await _get('/festivals/$festivalId/events/check-conflict', params) as Map);
  }

