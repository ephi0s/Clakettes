# Clakettes — variables de entorno del backend (backend/.env)
# Copia este archivo a backend/.env y ajusta los valores.

# ── Motor de base de datos ──────────────────────────────────────────
# Desarrollo (por defecto, sin configuración):
DATABASE_URL=sqlite:///./clakettes.db

# Producción con MariaDB (descomenta y ajusta):
# DATABASE_URL=mariadb+pymysql://clakettes_user:clakettes_password@localhost:3306/clakettes_db?ssl_ca=...
# Para Docker Compose con perfil db/prod:
# DATABASE_URL=mariadb+pymysql://clakettes_user:clakettes_password@db:3306/clakettes_db

# ── Seguridad ─────────────────────────────────────────────────────────
SECRET_KEY=cambia-esta-clave-en-produccion

# Orígenes CORS permitidos (*, o dominios explícitos en producción)
CORS_ORIGINS=*

# URL pública del nodo (federación, WebFinger, manifiesto)
PUBLIC_BASE_URL=http://localhost:8000

# IPs de proxy de confianza (útil detrás de nginx/Traefik)
FORWARDED_ALLOW_IPS=127.0.0.1

# ── MariaDB (solo si usas el contenedor db) ───────────────────────────
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=clakettes_db
MARIADB_USER=clakettes_user
MARIADB_PASSWORD=clakettes_password
