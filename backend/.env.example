# Clakettes — variables de entorno del backend (backend/.env)
# Copia este archivo a backend/.env y ajusta los valores.

# ── Motor de base de datos ──────────────────────────────────────────
# Desarrollo (por defecto, sin configuración):
DATABASE_URL=sqlite:///./clakettes.db

# Producción con MariaDB (descomenta y ajusta):
# DATABASE_URL=mariadb+pymysql://clakettes_user:clakettes_password@localhost:3306/clakettes_db?ssl_ca=...
# Para Docker Compose con perfil db/prod:
# DATABASE_URL=mariadb+pymysql://clakettes_user:clakettes_password@db:3306/clakettes_db

# ── Entorno ───────────────────────────────────────────────────────────
# development crea el admin inicial y las tablas con create_all; production
# exige SECRET_KEY robusta, orígenes CORS explícitos y esquema vía Alembic.
APP_ENV=development
# TESTING=1|true|yes|on desactiva el rate limiter y la auto-migración (solo en tests).
# SKIP_AUTO_MIGRATE=1 omite la auto-migración al arrancar (DB gestionada a mano).

# ── Seguridad ─────────────────────────────────────────────────────────
SECRET_KEY=cambia-esta-clave-en-produccion

# Orígenes CORS permitidos (*, o dominios explícitos en producción)
CORS_ORIGINS=*

# URL pública del nodo (federación, WebFinger, manifiesto)
PUBLIC_BASE_URL=http://localhost:8000

# IPs de proxy de confianza (útil detrás de nginx/Traefik)
FORWARDED_ALLOW_IPS=127.0.0.1

# ── Federación (mTLS) ──────────────────────────────────────────────────
# En producción, MTLS_REQUIRED=true exige certificado de cliente válido y registrado.
MTLS_REQUIRED=false
# CA raíz para validar certificados de clientes federados.
MTLS_CA_BUNDLE_PATH=
# Certificado y clave propios: validan peering y firman el manifiesto RSA-SHA256.
MTLS_CLIENT_CERT_PATH=
MTLS_CLIENT_KEY_PATH=

# ── Límites y JWT ──────────────────────────────────────────────────────
# RATE_LIMITS_DB_PATH=./rate_limits.db
# JWT_ISSUER=clakettes
# JWT_AUDIENCE=clakettes-api
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Pagos (mock por defecto) ───────────────────────────────────────────
PAYMENTS_PROVIDER=mock
MOCK_WEBHOOK_SECRET=
MOCK_PAYMENTS_FORCE_FAIL=false
# Stripe (requiere pip install stripe)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Redsys (firma HMAC_SHA256_V1 sin SDK; sandbox por defecto)
# REDSYS_MERCHANT_CODE=
# REDSYS_TERMINAL=1
# REDSYS_SECRET_KEY=
# REDSYS_SANDBOX=true
# REDSYS_CURRENCY=978

# ── MariaDB (solo si usas el contenedor db) ───────────────────────────
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=clakettes_db
MARIADB_USER=clakettes_user
MARIADB_PASSWORD=clakettes_password
