# For development (default, no configuration needed):
# DATABASE_URL=sqlite:///./clakettes.db

# Environment: development (default) | production. In production the app
# requires SECRET_KEY from env and does NOT auto-create the default admin.
APP_ENV=development

# For MariaDB production:
# DATABASE_URL=mariadb+pymysql://clakettes_user:clakettes_password@localhost:3306/clakettes_db

# JWT Authentication (CHANGE THIS IN PRODUCTION!)
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (comma-separated list of allowed origins)
# In production, set to your domain(s):
# CORS_ORIGINS=https://clakettes.com,https://www.clakettes.com
CORS_ORIGINS=

# Public origin of the site (no trailing slash). Used to build absolute URLs
# inside exported iCalendar (the RFC 5545 URL property); omitted when unset.
# PUBLIC_BASE_URL=https://clakettes.com

# Reverse-proxy IPs allowed to set X-Forwarded-* headers (uvicorn
# FORWARDED_ALLOW_IPS). Set it so the app can tell that a request arrived over
# HTTPS. CalDAV tokens are bearer credentials sent in the URL, so TLS
# termination in front of this service is required in production.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Admin user (auto-created in non-prod, or via seed_admin script)
# Default: admin / setup (CHANGE PASSWORD AFTER FIRST LOGIN)
