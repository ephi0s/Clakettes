# Para desarrollo (por defecto, sin configurar nada):
# DATABASE_URL=sqlite:///./clakettes.db

# Entorno: development (defecto) | production. En producción la app
# exige SECRET_KEY por env y NO crea el admin por defecto.
APP_ENV=development

# Para MariaDB en producción (TLS obligatorio con APP_ENV=production):
# DATABASE_URL=mariadb+pymysql://clakettes_user:clakettes_password@localhost:3306/clakettes_db?ssl_ca=/run/secrets/db-ca.pem

# Autenticación JWT (SECRET_KEY obligatorio, sin valor por defecto)
# Generen una clave fuerte: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambien-esto-por-una-clave-aleatoria-de-64-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Emisor/audiencia esperados en los tokens (opcional, valores por defecto abajo)
# JWT_ISSUER=clakettes
# JWT_AUDIENCE=clakettes-api

# CORS (lista de orígenes permitidos, separados por comas)
# En producción, pongan sus dominios:
# CORS_ORIGINS=https://clakettes.com,https://www.clakettes.com
CORS_ORIGINS=

# Origen público del sitio (sin barra final). Se usa para construir URLs
# absolutas dentro del iCalendar exportado (propiedad URL del RFC 5545);
# si no se define, se omite.
# PUBLIC_BASE_URL=https://clakettes.com

# IPs del proxy inverso con permiso para cabeceras X-Forwarded-* (uvicorn
# FORWARDED_ALLOW_IPS). Ajústenlo para que la app sepa que la petición llegó por
# HTTPS. Los tokens CalDAV son credenciales bearer en la URL, así que en
# producción hace falta TLS delante de este servicio.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Usuario admin (autocreado fuera de prod; por defecto: admin / setup, ¡CAMBIEN LA CLAVE AL ENTRAR!)

# Pagos (PAYMENTS_PROVIDER=mock por defecto; MOCK_WEBHOOK_SECRET para el webhook simulado)
# Stripe: STRIPE_SECRET_KEY=sk_test_... + STRIPE_WEBHOOK_SECRET=whsec_... (+ `pip install stripe`)
# Redsys: REDSYS_MERCHANT_CODE + REDSYS_SECRET_KEY (base64 del banco) + REDSYS_SANDBOX=true
#   Bizum va por Redsys sin integración aparte (DS_MERCHANT_PAYMETHODS=z, previo alta en el comercio).
