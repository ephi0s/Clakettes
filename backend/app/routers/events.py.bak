# ===========================
# Events
# ===========================


def _to_naive_utc(value: datetime | None) -> datetime | None:
    """Convert an aware datetime to naive UTC to match the stored format."""
    if value is None:
        return None
    if value.tzinfo is not None:
        return value.astimezone(timezone.utc).replace(tzinfo=None)
    return value


_VALID_VISIBILITY_SCOPES = {scope.value for scope in EventVisibilityScope}


def _validate_visibility_scope(value: str | None) -> str | None:
    """Reject unknown visibility scopes early with a clear 422."""
    if value is None:
        return None
    if value not in _VALID_VISIBILITY_SCOPES:
        raise HTTPException(
            status_code=422,
            detail=f"Invalid visibility_scope '{value}'. Expected one of: {sorted(_VALID_VISIBILITY_SCOPES)}",
        )
    return value


@router.get("/festivals/{festival_id}/events/", response_model=EventPage)
async def list_events(
    festival_id: int,
    page: int = Query(1, ge=1),
    size: int = Query(20, ge=1, le=100),
    is_active: bool | None = None,
    is_public: bool | None = None,
    event_type: str | None = None,
    start_date_from: datetime | None = None,
    start_date_to: datetime | None = None,
    db: Session = Depends(get_db),
):
    festival = festival_service.get(db, festival_id)
    if not festival:
        raise HTTPException(status_code=404, detail="Festival not found")
    return event_service.get_by_festival_paginated(
        db,
        festival_id,
        page,
        size,
        is_active,
        is_public,
        event_type,
        _to_naive_utc(start_date_from),
        _to_naive_utc(start_date_to),
    )


@router.get("/festivals/{festival_id}/events/export/ics")
async def export_festival_events_ics(
    festival_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    festival = festival_service.get(db, festival_id)
    if not festival:
        raise HTTPException(status_code=404, detail="Festival not found")
    require_festival_admin(db, current_user, festival_id)
    ics_content = export_events_ics(festival)
    return StreamingResponse(
        iter([ics_content.encode("utf-8")]),
        media_type="text/calendar",
        headers={"Content-Disposition": "attachment; filename=calendar.ics"},
    )


@router.post("/festivals/{festival_id}/events/", response_model=EventResponse, status_code=201)
async def create_event(
    festival_id: int,
    event: EventCreate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    festival = festival_service.get(db, festival_id)
    if not festival:
        raise HTTPException(status_code=404, detail="Festival not found")
    require_festival_admin(db, current_user, festival_id)
    _validate_visibility_scope(event.visibility_scope)
    conflict = event_service.find_conflict(
        db, festival_id, event.venue, _to_naive_utc(event.start_date), _to_naive_utc(event.end_date)
    )
    if conflict:
        raise HTTPException(status_code=409, detail=f"Schedule conflict with event {conflict.id} in '{event.venue}'")
    created = event_service.create(db, event, festival_id=festival_id, created_by=current_user.id)
    return event_service.set_visible_roles(db, created, event.visible_role_ids)


@router.get("/events/{event_id}", response_model=EventResponse)
async def get_event(event_id: int, db: Session = Depends(get_db)):
    event = event_service.get(db, event_id)
    if not event:
        raise HTTPException(status_code=404, detail="Event not found")
    return event


@router.put("/events/{event_id}", response_model=EventResponse)
async def update_event(
    event_id: int,
    event: EventUpdate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    existing = event_service.get(db, event_id)
    if not existing:
        raise HTTPException(status_code=404, detail="Event not found")
    require_festival_admin(db, current_user, existing.festival_id)
    _validate_visibility_scope(event.visibility_scope)
    new_start = _to_naive_utc(event.start_date) if event.start_date is not None else existing.start_date
    new_end = _to_naive_utc(event.end_date) if event.end_date is not None else existing.end_date
    new_venue = event.venue if event.venue is not None else existing.venue
    conflict = event_service.find_conflict(
        db, existing.festival_id, new_venue, new_start, new_end, exclude_event_id=event_id
    )
    if conflict:
        raise HTTPException(status_code=409, detail=f"Schedule conflict with event {conflict.id} in '{new_venue}'")
    updated = event_service.update(db, event_id, event)
    if not updated:
        raise HTTPException(status_code=404, detail="Event not found")
    return updated


@router.delete("/events/{event_id}")
async def delete_event(
    event_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    existing = event_service.get(db, event_id)
    if not existing:
        raise HTTPException(status_code=404, detail="Event not found")
    require_festival_admin(db, current_user, existing.festival_id)
    result = event_service.delete(db, event_id)
    if not result:
        raise HTTPException(status_code=404, detail="Event not found")
    return {"message": "Event deleted"}


