# ===========================
# Public Profile (by alias token — no auth, no user ID)
# ===========================


@router.get("/public/profile/{token}", response_model=dict)
async def get_public_profile_by_token(
    token: str,
    db: Session = Depends(get_db),
):

    alias = alias_service.get_by_token(db, token)
    if not alias:
        raise HTTPException(status_code=404, detail="Profile not found")

    user = alias.user
    festivals_to_show = []

    if alias.visibility_scope == "all_associated":
        all_aliases = alias_service.get_by_user(db, user.id, context="festival")
        festivals_to_show = [a.context_id for a in all_aliases if a.context_id and a.is_public]
    else:
        if alias.context_id:
            festivals_to_show = [alias.context_id]

    awards_data = []
    roles_data = []
    tags_data = []
    festival_names = []

    festivals = {f.id: f for f in festival_service.get_multi_by_ids(db, festivals_to_show)}
    awards_by_festival = {fid: [] for fid in festivals_to_show}
    roles_by_festival = {fid: [] for fid in festivals_to_show}
    tags_by_festival = {fid: [] for fid in festivals_to_show}

    if alias.show_awards:
        for a in award_service.get_by_festivals(db, festivals_to_show, user_id=user.id, is_public=True):
            awards_by_festival[a.festival_id].append(a)
    for r in user_role_service.get_by_user_in_festivals(db, user.id, festivals_to_show, include_hidden=True):
        if r.status == UserRoleStatus.APPROVED.value and not r.is_hidden:
            roles_by_festival[r.festival_id].append(r)
    for t in user_participant_tag_service.get_by_user_in_festivals(db, user.id, festivals_to_show):
        if not t.is_hidden:
            tags_by_festival[t.festival_id].append(t)

    for fid in festivals_to_show:
        f = festivals.get(fid)
        if f:
            festival_names.append({"id": f.id, "name": f.name, "logo_url": f.logo_url})

        for a in awards_by_festival[fid]:
            awards_data.append(
                {
                    "id": a.id,
                    "festival_id": fid,
                    "award_name": a.award_name,
                    "award_category": a.award_category,
                    "position": a.position,
                    "is_winner": a.is_winner,
                    "year": a.year,
                }
            )

        for r in roles_by_festival[fid]:
            role_name = r.role.display_name if r.role else None
            roles_data.append({"id": r.id, "role_id": r.role_id, "role_name": role_name})

        for t in tags_by_festival[fid]:
            tag_name = t.tag.display_name if t.tag else None
            tags_data.append({"id": t.id, "tag_id": t.tag_id, "tag_name": tag_name})

    return {
        "alias": alias.alias,
        "alias_id": alias.id,
        "context": alias.context,
        "context_id": alias.context_id,
        "visibility_scope": alias.visibility_scope,
        "avatar_url": user.avatar_url,
        "bio": user.bio if user.is_public_bio else None,
        "festivals": festival_names,
        "awards": awards_data,
        "roles": roles_data,
        "tags": tags_data,
    }


@router.get("/festivals/{festival_id}/users/{user_id}/profile", response_model=dict)
async def get_festival_user_profile(
    festival_id: int,
    user_id: int,
    db: Session = Depends(get_db),
):

    festival = festival_service.get(db, festival_id)
    if not festival:
        raise HTTPException(status_code=404, detail="Festival not found")
    user = user_service.get(db, user_id)
    if not user:
        raise HTTPException(status_code=404, detail="User not found")

    alias = None
    show_awards_alias = False
    festival_alias = alias_service.get_by_user_and_context(db, user_id, "festival", festival_id)
    if festival_alias:
        alias = festival_alias.alias
        show_awards_alias = festival_alias.show_awards

    awards = award_service.get_by_festival(db, festival_id, user_id=user_id, is_public=True)

    roles = user_role_service.get_by_user(db, user_id, festival_id=festival_id, include_hidden=True)
    roles = [r for r in roles if r.status == UserRoleStatus.APPROVED.value and not r.is_hidden]

    tags = user_participant_tag_service.get_by_user(db, user_id, festival_id=festival_id)
    tags = [t for t in tags if not t.is_hidden]

    display_name = alias if alias and festival.allow_alias_display else (user.full_name or user.username)
    awards_data = []
    for a in awards:
        if not alias or show_awards_alias:
            awards_data.append(
                {
                    "id": a.id,
                    "award_name": a.award_name,
                    "award_category": a.award_category,
                    "position": a.position,
                    "is_winner": a.is_winner,
                    "year": a.year,
                }
            )

    return {
        "display_name": display_name,
        "username": user.username,
        "alias": alias,
        "avatar_url": user.avatar_url,
        "bio": user.bio if user.is_public_bio else None,
        "awards": awards_data,
        "roles": [
            {
                "id": r.id,
                "role_id": r.role_id,
                "role_name": r.role.display_name if r.role else None,
            }
            for r in roles
        ],
        "tags": [{"id": t.id, "tag_id": t.tag_id, "tag_name": t.tag.display_name if t.tag else None} for t in tags],
    }
