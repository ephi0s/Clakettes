@router.get("/festivals/{festival_id}/events/check-conflict")
async def check_conflict(
    festival_id: int,
    venue: str,
    start_date: datetime,
    end_date: datetime | None = None,
    exclude_event_id: int | None = None,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    require_festival_admin(db, current_user, festival_id)
    conflict = event_service.find_conflict(
        db, festival_id, venue, _to_naive_utc(start_date), _to_naive_utc(end_date), exclude_event_id
    )
    return {"conflict": conflict.id if conflict else None, "venue": venue}


@router.get("/events/{event_id}/screenings")
async def list_screenings(event_id: int, db: Session = Depends(get_db)):
    from app.models.event_screening import EventScreening

    event = event_service.get(db, event_id)
    if not event:
        raise HTTPException(status_code=404, detail="Event not found")
    rows = (
        db.query(EventScreening).filter(EventScreening.event_id == event_id).order_by(EventScreening.sort_order).all()
    )
    items = [
        {
            "shortfilm_id": r.shortfilm_id,
            "sort_order": r.sort_order or 0,
            "title": r.shortfilm.title if r.shortfilm else None,
            "duration": r.shortfilm.duration if r.shortfilm else None,
        }
        for r in rows
    ]
    total = sum(i["duration"] for i in items if i["duration"])
    return {
        "event_id": event_id,
        "shortfilm_ids": [i["shortfilm_id"] for i in items],
        "items": items,
        "total_duration": total,
    }


@router.put("/events/{event_id}/screenings")
async def set_screenings(
    event_id: int,
    body: dict,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    event = event_service.get(db, event_id)
    if not event:
        raise HTTPException(status_code=404, detail="Event not found")
    require_festival_admin(db, current_user, event.festival_id)
    ids = body.get("shortfilm_ids", [])
    updated = event_service.set_screenings(db, event, [int(i) for i in ids])
    return {"event_id": event_id, "shortfilm_ids": updated.screening_shortfilm_ids}


@router.get("/events/{event_id}/occupancy")
async def get_occupancy(event_id: int, db: Session = Depends(get_db)):
    event = event_service.get(db, event_id)
    if not event:
        raise HTTPException(status_code=404, detail="Event not found")
    return {"event_id": event_id, **event_service.occupancy(db, event)}


