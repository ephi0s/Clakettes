@router.get("/events/{event_id}/attendees/export/csv")
async def export_event_attendees_csv(
    event_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    event = event_service.get(db, event_id)
    if not event:
        raise HTTPException(status_code=404, detail="Event not found")
    require_festival_admin(db, current_user, event.festival_id)
    csv_buffer = export_attendees_csv(event)
    return StreamingResponse(
        iter([csv_buffer.getvalue().encode("utf-8-sig")]),
        media_type="text/csv",
        headers={"Content-Disposition": "attachment; filename=attendees.csv"},
    )


@router.delete("/attendees/{attendee_id}")
async def delete_attendee(
    attendee_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    existing = attendee_service.get(db, attendee_id)
    if not existing:
        raise HTTPException(status_code=404, detail="Attendee not found")
    event = event_service.get(db, existing.event_id)
    if not event:
        raise HTTPException(status_code=404, detail="Event not found")
    if existing.user_id != current_user.id and not is_admin(current_user):
        require_festival_admin(db, current_user, event.festival_id)
    result = attendee_service.delete_with_seat_release(db, attendee_id)
