    if not event:
        raise HTTPException(status_code=404, detail="Event not found")
    return reservation_service.get_by_event_paginated(db, event_id, page, size, status)


@router.post("/events/{event_id}/reservations/", response_model=EventReservationResponse, status_code=201)
async def create_reservation(
    event_id: int,
    reservation: EventReservationCreate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    event = event_service.get(db, event_id)
    if not event:
        raise HTTPException(status_code=404, detail="Event not found")
    result = reservation_service.create_with_attendees(db, current_user.id, reservation)
    if not result:
        raise HTTPException(status_code=400, detail="Could not create reservation")
    return result


@router.put("/reservations/{reservation_id}", response_model=EventReservationResponse)
async def update_reservation(
    reservation_id: int,
    reservation: EventReservationUpdate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    existing = reservation_service.get(db, reservation_id)
    if not existing:
        raise HTTPException(status_code=404, detail="Reservation not found")
    event = event_service.get(db, existing.event_id)
    if not event:
        raise HTTPException(status_code=404, detail="Event not found")
    if existing.user_id != current_user.id and not is_admin(current_user):
        require_festival_admin(db, current_user, event.festival_id)
    updated = reservation_service.update(db, reservation_id, reservation)
    if not updated:
        raise HTTPException(status_code=404, detail="Reservation not found")
    return updated


