@router.get("/events/{event_id}/attendees/", response_model=EventAttendeePage)
async def list_attendees(
    event_id: int,
    page: int = Query(1, ge=1),
    size: int = Query(20, ge=1, le=100),
    status: str | None = None,
    include_hidden: bool = False,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    event = event_service.get(db, event_id)
    if not event:
        raise HTTPException(status_code=404, detail="Event not found")
    return attendee_service.get_by_event_paginated(db, event_id, page, size, status, include_hidden)


@router.post("/events/{event_id}/attendees/", response_model=EventAttendeeResponse, status_code=201)
async def create_attendee(
    event_id: int,
    attendee: EventAttendeeCreate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    event = event_service.get(db, event_id)
    if not event:
        raise HTTPException(status_code=404, detail="Event not found")
    if attendee.seat_id:
        seat = seat_service.get(db, attendee.seat_id)
        if not seat:
            raise HTTPException(status_code=404, detail="Seat not found")
        if seat.status != SeatStatus.AVAILABLE.value:
            raise HTTPException(status_code=400, detail="Seat is not available")
    return attendee_service.create_with_seat(db, attendee, event_id, current_user.id)


@router.get("/attendees/{attendee_id}", response_model=EventAttendeeResponse)
async def get_attendee(attendee_id: int, db: Session = Depends(get_db)):
    attendee = attendee_service.get(db, attendee_id)
    if not attendee:
        raise HTTPException(status_code=404, detail="Attendee not found")
    return attendee


@router.put("/attendees/{attendee_id}", response_model=EventAttendeeResponse)
async def update_attendee(
    attendee_id: int,
    attendee: EventAttendeeUpdate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    existing = attendee_service.get(db, attendee_id)
    if not existing:
        raise HTTPException(status_code=404, detail="Attendee not found")
    event = event_service.get(db, existing.event_id)
    if not event:
        raise HTTPException(status_code=404, detail="Event not found")
    if existing.user_id != current_user.id and not is_admin(current_user):
        require_festival_admin(db, current_user, event.festival_id)
    updated = attendee_service.update(db, attendee_id, attendee)
    if not updated:
        raise HTTPException(status_code=404, detail="Attendee not found")
    return updated


@router.post("/attendees/{attendee_id}/check-in")
async def check_in_attendee(
    attendee_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    existing = attendee_service.get(db, attendee_id)
    if not existing:
        raise HTTPException(status_code=404, detail="Attendee not found")
    event = event_service.get(db, existing.event_id)
    if not event:
        raise HTTPException(status_code=404, detail="Event not found")
    if existing.user_id != current_user.id and not is_admin(current_user):
        require_festival_admin(db, current_user, event.festival_id)
    result = attendee_service.check_in(db, attendee_id)
    if not result:
        raise HTTPException(status_code=404, detail="Attendee not found")
    return {"message": "Check-in successful", "attendee": result}


